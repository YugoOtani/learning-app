{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "title": "変更レビュー",
  "type": "object",
  "required": [
    "version",
    "summary",
    "evidence",
    "change_units"
  ],
  "properties": {
    "version": {
      "type": "string"
    },

    "summary": {
      "type": "object",
      "required": [
        "title",
        "review",
        "recommended_action"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "review": {
          "type": "string"
        },
        "recommended_action": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },

    "change_units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change_unit"
      }
    }
  },

  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "format",
            "lint",
            "typecheck",
            "unit_test",
            "integration_test",
            "e2e",
            "build",
            "manual",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "command": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "change_unit": {
      "type": "object",
      "required": [
        "id",
        "title",
        "implementation",
        "review",
        "references"
      ],
      "properties": {
        "id": {
          "type": "string"
        },

        "title": {
          "type": "string"
        },

        "implementation": {
          "$ref": "#/$defs/implementation"
        },

        "review": {
          "$ref": "#/$defs/review"
        },

        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "additionalProperties": false
    },

    "implementation": {
      "type": "object",
      "required": [
        "summary",
        "description",
        "sections"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/implementation_section"
          }
        }
      },
      "additionalProperties": false
    },

    "implementation_section": {
      "type": "object",
      "required": [
        "title",
        "path",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string"
        },

        "path": {
          "type": "string"
        },

        "symbol": {
          "type": "string"
        },

        "start_line": {
          "type": "integer",
          "minimum": 1
        },

        "end_line": {
          "type": "integer",
          "minimum": 1
        },

        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "review": {
      "type": "object",
      "required": [
        "risk",
        "assessment",
        "human_review_required"
      ],
      "properties": {
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },

        "assessment": {
          "type": "string"
        },

        "human_review_required": {
          "type": "boolean"
        },

        "human_review_focus": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "human_review_required": {
                "const": true
              }
            },
            "required": [
              "human_review_required"
            ]
          },
          "then": {
            "required": [
              "human_review_focus"
            ]
          }
        }
      ],
      "additionalProperties": false
    },

    "reference": {
      "type": "object",
      "required": [
        "type",
        "path",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "spec",
            "test_plan",
            "implementation",
            "test",
            "other"
          ]
        },

        "path": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "section": {
          "type": "string"
        },

        "symbol": {
          "type": "string"
        },

        "start_line": {
          "type": "integer",
          "minimum": 1
        },

        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
